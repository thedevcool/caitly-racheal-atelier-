# Postgres (Neon or Vercel Postgres). Use the pooled URL on Vercel.
DATABASE_URL=
# Auth.js: generate with `openssl rand -base64 32`
AUTH_SECRET=
ADMIN_EMAIL=
# bcrypt hash: generate with `pnpm admin:hash` (phase 4)
ADMIN_PASSWORD_HASH=
# Vercel Blob. When empty, uploads are stored in public/uploads (local development only).
BLOB_READ_WRITE_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=her.address@gmail.com
SMTP_APP_PASSWORD=
NEXT_PUBLIC_SITE_URL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
